# Local Docker/OrbStack environment for Missions.dev. Copied to /config.env on first `make up`.
# Real secrets never belong here - this file is committed.
timezone="UTC"
environment="development"
protocol="http"
platform_key="sandbox"
platform_config="sandbox.yaml"
platform_secret_key="__GENERATED__"
database_name="idea-village-sandbox"
database_user="missions"
database_pass="missions"
database_hostname="db"
allow_api_access="yes"
load_variables_by_hostname="no"
pusher_api_key=""
pusher_secret=""
pusher_app_id=""
# Dummy AWS credentials stop the SDK from probing EC2 instance metadata (slow timeouts).
# Image uploads (S3) and e-mail sending (SQS/SES) will not work locally without real ones.
AWS_ACCESS_KEY_ID="local-dummy"
AWS_SECRET_ACCESS_KEY="local-dummy"
AWS_EC2_METADATA_DISABLED="true"
send_email_queue_url=""
payday_secret_development=""
payday_client_id_development=""
invoicing_mode="development"
